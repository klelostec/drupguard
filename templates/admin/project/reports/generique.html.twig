{# @var project \App\Entity\Project #}
{# @var report \App\Entity\Report\ReportAbstract #}

{% if report.detail %}
    <div>
        {{ report.detail | raw }}
    </div>
{% endif %}

{% if report.items.count > 0 %}
    {% set filterId = 'filter-' ~ report.id %}
    {% set tableId = 'table-' ~ report.id %}
    <div id="{{ filterId }}" class="filter-wrapper d-flex align-items-center my-3" data-table-id="{{ tableId }}">
        <div class="d-inline-flex me-4 fw-bold">{{ 'State filters :' | trans }}</div>
        {% for currentAnalyseLevelState in analyseLevelStates %}
            <div class="d-inline-flex mx-2">
                <input type="checkbox" for="filter-level-{{ report.id ~ '-' ~ currentAnalyseLevelState.name | lower }}" class="filter-checkbox" value="{{ currentAnalyseLevelState.name | lower }}"/>
                <label id="filter-level-{{ report.id ~ '-' ~ currentAnalyseLevelState.name }}" class="ps-1">{{ currentAnalyseLevelState.label }}</label>
            </div>
        {% endfor %}
    </div>
    <table
        id="{{ tableId }}"
        class="table-responsive"
        data-toggle="table"
        data-filter-control="true"
        data-sort-reset="true"
        data-search-align="left">
        <thead>
        {% block table_head %}
            <tr>
                {% block table_head_item %}
                    <th scope="col"
                        data-field="name"
                        data-sortable="true"
                        data-filter-control="input">{{ 'Name' | trans }}</th>
                    <th scope="col"
                        data-field="type"
                        data-sortable="true"
                        data-filter-control="select">{{ 'Type' | trans }}</th>
                    <th scope="col"
                        data-field="current_version">{{ 'Current version' | trans }}</th>
                    <th scope="col"
                        data-field="detail">{{ 'Detail' | trans }}</th>
                {% endblock table_head_item %}
                <th scope="col"
                    data-field="state"
                    data-visible="false">
                    {{ 'State' | trans }}
                </th>
            </tr>
        {% endblock table_head %}
        </thead>
        <tbody>
        {% block table_body %}
            {% for reportItem in report.items %}
                <tr class="table-state-{{ reportItem.state.name | lower }}">
                    {% block table_row_item %}
                        <th scope="row">{{ reportItem.name }}</th>
                        <td>{{ reportItem.type }}</td>
                        <td>{{ reportItem.currentVersion }}</td>
                        <td>{{ reportItem.detail }}</td>
                    {% endblock table_row_item %}
                    <td>{{ reportItem.state.name | lower }}</td>
                </tr>
            {% endfor %}
        {% endblock table_body %}
        </tbody>
    </table>
{% endif %}