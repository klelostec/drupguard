{# @var project \App\Entity\Project #}
{# @var report \App\Entity\Report\Type\ReportDrupal #}
{# @var reportItem \App\Entity\Report\Type\ReportDrupalItem #}
{% extends 'admin/project/reports/generique.html.twig' %}

{% block table_head_item %}
    <th scope="col">Name</th>
    <th scope="col">Type</th>
    <th scope="col">Current version</th>
    <th scope="col">Latest version</th>
    <th scope="col">Recommanded version</th>
    <th scope="col">Detail</th>
{% endblock table_head_item %}
{% block table_row_item %}
    <th scope="row">{{ reportItem.name }}</th>
    <td>{{ reportItem.type }}</td>
    <td>{{ reportItem.currentVersion }}</td>
    <td>{{ reportItem.latestVersion }}</td>
    <td>{{ reportItem.recommandedVersion }}</td>
    <td>{{ reportItem.detail | raw }}</td>
{% endblock table_row_item %}